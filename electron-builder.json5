// Packaging for SquashMedia, into release/<version>:
//   Windows: npm run fetch:ffmpeg && npm run dist:win     -> Setup and portable .exe
//   macOS:   fetch mac-arm64 and mac-x64, npm run dist:mac -> a .dmg for each
//   Linux:   npm run fetch:ffmpeg -- linux && npm run dist:linux -> AppImage and .deb
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'com.squashmedia.app',
  productName: 'SquashMedia',
  copyright: 'Copyright © 2026 SquashMedia contributors',
  directories: {
    buildResources: 'build',
    output: 'release/${version}',
  },
  // Production dependencies (sharp, systeminformation) are added automatically;
  // everything the renderer needs is already bundled into out/.
  files: [
    'out/**/*',
    'package.json',
    '!**/*.map',
  ],
  asar: true,
  // sharp loads native libvips binaries, which cannot run from inside an asar.
  asarUnpack: ['node_modules/sharp/**/*', 'node_modules/@img/**/*'],
  // sharp ships N-API prebuilds, so nothing needs compiling for Electron.
  npmRebuild: false,
  // Where the auto-updater looks. The build scripts pass --publish never and
  // CI attaches the files (including latest.yml) to the GitHub release.
  publish: [{ provider: 'github', owner: 'joshov13-dev', repo: 'squash-media', releaseType: 'release' }],
  // The interface is English only, so drop Chromium's other 50-odd language packs.
  electronLanguages: ['en-US', 'en-GB'],
  // Smaller download at the cost of a slower build.
  compression: 'maximum',
  win: {
    icon: 'build/icon.png',
    executableName: 'SquashMedia',
    target: [
      { target: 'nsis', arch: ['x64'] },
      { target: 'portable', arch: ['x64'] },
    ],
    extraResources: [
      {
        from: 'binaries/win',
        to: 'bin',
        filter: ['ffmpeg.exe', 'ffprobe.exe', '*.dll', 'FFMPEG-LICENSE.txt'],
      },
    ],
  },
  nsis: {
    // Right-click "Compress with SquashMedia" and the "Send to" entry.
    include: 'build/installer.nsh',
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: 'SquashMedia',
    uninstallDisplayName: 'SquashMedia',
    artifactName: '${productName}-Setup-${version}-x64.${ext}',
  },
  portable: {
    artifactName: '${productName}-Portable-${version}-x64.${ext}',
  },
  mac: {
    icon: 'build/icon.png',
    category: 'public.app-category.photography',
    target: [{ target: 'dmg', arch: ['arm64', 'x64'] }],
    // No Apple Developer certificate, so no notarisation: sign ad hoc so Apple
    // silicon Macs will run it. Gatekeeper still blocks the first launch; the
    // README walks people through Privacy & Security > Open Anyway.
    identity: '-',
    hardenedRuntime: false,
    gatekeeperAssess: false,
    extraResources: [
      {
        from: 'binaries/mac-${arch}',
        to: 'bin',
        filter: ['ffmpeg', 'ffprobe', 'FFMPEG-LICENSE.txt'],
      },
    ],
  },
  dmg: {
    artifactName: '${productName}-${version}-mac-${arch}.${ext}',
  },
  linux: {
    icon: 'build/icon.png',
    category: 'Graphics',
    executableName: 'squashmedia',
    maintainer: 'SquashMedia <squashmedia@users.noreply.github.com>',
    synopsis: 'Compress photos and videos',
    target: [
      { target: 'AppImage', arch: ['x64'] },
      { target: 'deb', arch: ['x64'] },
    ],
    extraResources: [
      {
        from: 'binaries/linux',
        to: 'bin',
        filter: ['ffmpeg', 'ffprobe', 'FFMPEG-LICENSE.txt'],
      },
    ],
  },
  appImage: {
    artifactName: '${productName}-${version}-x86_64.${ext}',
  },
  deb: {
    artifactName: '${productName}-${version}-amd64.${ext}',
  },
}
