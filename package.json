{
  "name": "squashforge",
  "productName": "SquashForge",
  "version": "0.1.0",
  "private": true,
  "description": "Batch image and video compressor for Windows. Caesium-style image squeezing and HandBrake-style video encoding in one queue.",
  "author": "SquashForge",
  "homepage": "https://github.com/joshov13-dev/squash-media",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --config electron-builder.json5",
    "dist:dir": "npm run build && electron-builder --dir --config electron-builder.json5"
  },
  "dependencies": {
    "sharp": "^0.35.4",
    "systeminformation": "^5.33.13"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  }
}
